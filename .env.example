# ==============================================================================
# OpsGuard — Enterprise Incident Response Self-RAG Copilot
# Environment Configuration Template
# Duplicate this file to '.env' and populate with your credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Groq LLM Configuration
# ------------------------------------------------------------------------------
# Get your API key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
# Recommended model: openai/gpt-oss-120b or llama-3.3-70b-versatile
GROQ_MODEL=openai/gpt-oss-120b

# ------------------------------------------------------------------------------
# 2. Pinecone Vector Database Configuration
# ------------------------------------------------------------------------------
# Get your API key from https://app.pinecone.io/
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=opsguard
PINECONE_NAMESPACE=company-documents
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
# Pinecone integrated embedding model (e.g. llama-text-embed-v2)
PINECONE_EMBEDDING_MODEL=llama-text-embed-v2

# ------------------------------------------------------------------------------
# 3. Tavily Search API (Fallback Internet Search)
# ------------------------------------------------------------------------------
# Get your API key from https://app.tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# ------------------------------------------------------------------------------
# 4. Self-RAG Behavioral Controls
# ------------------------------------------------------------------------------
TOP_K=5
MAX_SUPPORT_RETRIES=5
MAX_RETRIEVAL_REWRITES=5
MAX_WEB_REWRITES=3

# ------------------------------------------------------------------------------
# 5. Database & Persistent Storage Paths
# ------------------------------------------------------------------------------
DATABASE_PATH=data/audit.db

# ------------------------------------------------------------------------------
# 6. Optional: LangSmith Observability & Tracing
# ------------------------------------------------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=OpsGuard
